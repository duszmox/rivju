<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 requires writable-executable memory. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Native modules (better-sqlite3, lightningcss, @tailwindcss/oxide) are
         signed by their publishers, not by this team. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The main process spawns helpers with ELECTRON_RUN_AS_NODE and a
         modified environment. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
  </dict>
</plist>
