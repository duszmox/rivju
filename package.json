{
  "name": "rivju",
  "version": "0.0.1",
  "packageManager": "npm@10.9.2",
  "productName": "rivju",
  "description": "Agentic review of GitLab merge requests",
  "author": "rivju",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run dist:mac",
    "dist:mac": "electron-vite build && electron-builder --config electron-builder.config.cjs --mac dmg zip",
    "dist:win": "electron-vite build && electron-builder --config electron-builder.config.cjs --win nsis --x64",
    "dist:linux": "electron-vite build && electron-builder --config electron-builder.config.cjs --linux AppImage --x64",
    "dist:dir": "electron-vite build && electron-builder --config electron-builder.config.cjs --dir",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "check:release": "prettier --check .circleci README.md docs/releasing.md docs/plan/phase-9-release.md docs/plan/reports/phase-9.md electron-builder.config.cjs npm/rivju scripts src/main/db/client.ts src/main/db/migrate.ts src/main/db/migrate.test.ts src/main/index.ts src/main/paths.ts src/main/release-channel.ts src/main/release-channel.test.ts src/main/trpc/routers/updates.ts src/main/updates src/renderer/routes/settings.tsx",
    "generate-routes": "tsr generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "rebuild": "electron-rebuild --force --which-module better-sqlite3",
    "postinstall": "npm run rebuild",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.252",
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@trpc/client": "latest",
    "@trpc/server": "latest",
    "@trpc/tanstack-react-query": "latest",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "gitdiff-parser": "^0.3.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "latest",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.1.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
